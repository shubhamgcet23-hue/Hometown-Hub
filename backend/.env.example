# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL="postgresql://username:password@localhost:5432/hometown_hub?schema=public"

# ---- Auth ----
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# ---- URLs ----
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ---- File uploads (local dev) ----
UPLOAD_DIR=uploads

# ---- Cloud image storage (optional — enable for production) ----
CLOUDINARY_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
